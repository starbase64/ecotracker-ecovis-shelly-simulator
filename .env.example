# EcoTracker local HTTP endpoint
ECOTRACKER_URL=http://192.168.1.50:18080/v1/json

# Shelly installed at the AC output of the ECOVIS
INVERTER_URL=http://192.168.1.51/rpc/Switch.GetStatus?id=0
INVERTER_FIELD=apower

# Set to true when the Shelly reports generation as a negative value.
INVERTER_INVERT=true

# Conservative software ceiling below 800 W
MAX_OUTPUT_W=740
HARD_LIMIT_W=790

# Controller tuning
KP_UP=0.40
KP_DOWN=0.70
SETTLE_S=3.0
DEADBAND_W=15
